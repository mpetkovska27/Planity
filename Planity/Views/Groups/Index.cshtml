@model IEnumerable<Planity.Models.Group>
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Index";
    bool isAdmin = User.IsInRole("Admin");
    bool isTeamLeader = User.IsInRole("TeamLeader");
    string currentUserId = User.Identity.GetUserId();
    bool canCreate = isAdmin || isTeamLeader;
}

<h2>Index</h2>

@if (canCreate)
{
    <p>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
    </p>
}
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TeamLeader.FullName)
            </th>
            <th>
                Members Count
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            bool isItemLeader = item.TeamLeaderId == currentUserId;
            bool canEditDelete = isAdmin || isItemLeader;
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TeamLeader.FullName)
                </td>
                <td>
                    @(item.Members?.Count ?? 0)
                </td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info" })
                    @if (canEditDelete)
                    {
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                    }
                </td>
            </tr>
        }

    </table>
</div>
