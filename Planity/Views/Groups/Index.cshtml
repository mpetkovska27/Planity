@model IEnumerable<Planity.Models.Group>
@using Microsoft.AspNet.Identity
@using System.Linq

@{
    ViewBag.Title = "Groups";
    string currentUserId = User.Identity.GetUserId();
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">Groups</h2>
            <div class="text-muted">Collaborative workspaces for your teams</div>
        </div>
        <div>
            @if (User.IsInRole("Admin") || User.IsInRole("TeamLeader"))
            {
                @Html.ActionLink("Create New Group", "Create", null, new { @class = "btn btn-primary" })
            }
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model ?? Enumerable.Empty<Planity.Models.Group>())
        {
            bool isItemLeader = item.TeamLeaderId == currentUserId;
            <div class="col">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@item.Name</h5>
                            @if (isItemLeader)
                            {
                                <span class="badge bg-primary">Leader</span>
                            }
                        </div>
                        <div class="text-muted mb-2">
                            Team Leader:
                            <span class="fw-semibold">
                                @(item.TeamLeader?.Email ?? "Unassigned")
                            </span>
                        </div>
                        <div class="text-muted mb-4">
                            Members: <span class="fw-semibold">@(item.Members?.Count ?? 0)</span>
                        </div>
                        <div class="mt-auto">
                            @Html.ActionLink("View Workspace", "Details", new { id = item.Id }, new { @class = "btn btn-outline-primary w-100" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
