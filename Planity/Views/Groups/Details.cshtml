@model Planity.Models.Group
@using Microsoft.AspNet.Identity
@using System.Linq

@{
    ViewBag.Title = "Workspace";
    string currentUserId = User.Identity.GetUserId();
    bool isGroupLeader = Model.TeamLeaderId == currentUserId;
    bool isAdmin = User.IsInRole("Admin");
    bool canManage = isAdmin || isGroupLeader;
    var members = Model.Members ?? new List<Planity.Models.GroupMember>();
    var groupTasks = (Model.Tasks ?? new List<Planity.Models.TaskItem>()).Where(t => t.IsGroupTask).ToList();
    var todoTasks = groupTasks.Where(t => t.Status == Planity.Models.TaskStatus.ToDo).ToList();
    var inProgressTasks = groupTasks.Where(t => t.Status == Planity.Models.TaskStatus.InProgress).ToList();
    var doneTasks = groupTasks.Where(t => t.Status == Planity.Models.TaskStatus.Done).ToList();
    string description = ViewBag.Description as string;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1">@Model.Name</h2>
            <div class="text-muted">
                Team Leader: <span class="fw-semibold">@((Model.TeamLeader != null) ? Model.TeamLeader.Email : "Unassigned")</span>
                <span class="mx-2">•</span>
                Members: <span class="fw-semibold">@members.Count</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (canManage)
            {
                @Html.ActionLink("Edit Group", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Delete Group", "Delete", new { id = Model.Id }, new { @class = "btn btn-danger" })
            }
            @Html.ActionLink("Back to Groups", "Index", null, new { @class = "btn btn-outline-primary" })
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="groupWorkspaceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="kanban-tab" data-bs-toggle="tab" data-bs-target="#kanban" type="button" role="tab">Kanban Board</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="team-tab" data-bs-toggle="tab" data-bs-target="#team" type="button" role="tab">Team Management</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="about-tab" data-bs-toggle="tab" data-bs-target="#about" type="button" role="tab">About & Settings</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="kanban" role="tabpanel" aria-labelledby="kanban-tab">
            <div class="d-flex justify-content-end mb-3">
                @if (isGroupLeader || isAdmin)
                {
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#groupQuickAddTaskModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Task
                    </button>
                }
            </div>
            <div id="groupKanban" class="task-kanban">
                <div class="kanban-column" data-status="ToDo">
                    <h5>To Do</h5>
                    <div class="kanban-list">
                        @if (todoTasks.Any())
                        {
                            foreach (var task in todoTasks)
                            {
                                var statusStyle = "background: #e8ecf1; color: #4b5661;";
                                if (task.Status == Planity.Models.TaskStatus.InProgress)
                                {
                                    statusStyle = "background: #fff3cd; color: #856404;";
                                }
                                else if (task.Status == Planity.Models.TaskStatus.Done)
                                {
                                    statusStyle = "background: #d1e7dd; color: #0f5132;";
                                }
                                var priorityStyle = task.Priority == Planity.Models.Priority.High
                                    ? "background: #f8d7da; color: #842029;"
                                    : task.Priority == Planity.Models.Priority.Medium
                                        ? "background: #fff3cd; color: #856404;"
                                        : "background: #e2e3e5; color: #41464b;";
                                <div class="kanban-card"
                                     draggable="true"
                                     data-task-id="@task.Id"
                                     data-task-title="@Html.AttributeEncode(task.Title)"
                                     data-task-type="@task.Type.ToString()"
                                     data-task-priority="@task.Priority.ToString()"
                                     data-task-duedate="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <div class="title" style="font-weight: 600; color: var(--dark-color);">@task.Title</div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <span class="task-pill" style="@statusStyle">@task.Status</span>
                                        <span class="task-pill" style="@priorityStyle">@task.Priority</span>
                                    </div>
                                    <div class="kanban-meta">
                                        <span>Due @(task.DueDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">No tasks yet.</div>
                        }
                    </div>
                </div>
                <div class="kanban-column" data-status="InProgress">
                    <h5>In Progress</h5>
                    <div class="kanban-list">
                        @if (inProgressTasks.Any())
                        {
                            foreach (var task in inProgressTasks)
                            {
                                var statusStyle = "background: #fff3cd; color: #856404;";
                                var priorityStyle = task.Priority == Planity.Models.Priority.High
                                    ? "background: #f8d7da; color: #842029;"
                                    : task.Priority == Planity.Models.Priority.Medium
                                        ? "background: #fff3cd; color: #856404;"
                                        : "background: #e2e3e5; color: #41464b;";
                                <div class="kanban-card"
                                     draggable="true"
                                     data-task-id="@task.Id"
                                     data-task-title="@Html.AttributeEncode(task.Title)"
                                     data-task-type="@task.Type.ToString()"
                                     data-task-priority="@task.Priority.ToString()"
                                     data-task-duedate="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <div class="title" style="font-weight: 600; color: var(--dark-color);">@task.Title</div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <span class="task-pill" style="@statusStyle">@task.Status</span>
                                        <span class="task-pill" style="@priorityStyle">@task.Priority</span>
                                    </div>
                                    <div class="kanban-meta">
                                        <span>Due @(task.DueDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">No tasks in progress.</div>
                        }
                    </div>
                </div>
                <div class="kanban-column" data-status="Done">
                    <h5>Done</h5>
                    <div class="kanban-list">
                        @if (doneTasks.Any())
                        {
                            foreach (var task in doneTasks)
                            {
                                var statusStyle = "background: #d1e7dd; color: #0f5132;";
                                var priorityStyle = task.Priority == Planity.Models.Priority.High
                                    ? "background: #f8d7da; color: #842029;"
                                    : task.Priority == Planity.Models.Priority.Medium
                                        ? "background: #fff3cd; color: #856404;"
                                        : "background: #e2e3e5; color: #41464b;";
                                <div class="kanban-card"
                                     draggable="true"
                                     data-task-id="@task.Id"
                                     data-task-title="@Html.AttributeEncode(task.Title)"
                                     data-task-type="@task.Type.ToString()"
                                     data-task-priority="@task.Priority.ToString()"
                                     data-task-duedate="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <div class="title" style="font-weight: 600; color: var(--dark-color);">@task.Title</div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <span class="task-pill" style="@statusStyle">@task.Status</span>
                                        <span class="task-pill" style="@priorityStyle">@task.Priority</span>
                                    </div>
                                    <div class="kanban-meta">
                                        <span>Due @(task.DueDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">No completed tasks.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="team" role="tabpanel" aria-labelledby="team-tab">
            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light fw-semibold">Members</div>
                        <div class="card-body">
                            <div class="list-group list-group-flush">
                                @foreach (var member in members)
                                {
                                    bool isLeader = member.UserId == Model.TeamLeaderId;
                                    <div class="list-group-item d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="fw-semibold">@member.User.Email</div>
                                            <div class="text-muted small">@member.User.Email</div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (isLeader)
                                            {
                                                <span class="badge bg-primary">Leader</span>
                                            }
                                            else if (canManage)
                                            {
                                                using (Html.BeginForm("RemoveMember", "Groups", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("groupId", Model.Id)
                                                    @Html.Hidden("userId", member.UserId)
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!members.Any())
                                {
                                    <div class="text-muted">No members found.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light fw-semibold">Add Member</div>
                        <div class="card-body">
                            @if (canManage)
                            {
                                using (Html.BeginForm("AddMember", "Groups", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("groupId", Model.Id)
                                    <div class="mb-3">
                                        <label for="userEmail" class="form-label">User Email</label>
                                        <input type="email" name="userEmail" id="userEmail" class="form-control" required placeholder="name@company.com" />
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Add Member</button>
                                }
                            }
                            else
                            {
                                <div class="text-muted">Only the team leader or admin can add or remove members.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="about" role="tabpanel" aria-labelledby="about-tab">
            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light fw-semibold">About This Group</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="text-muted small">Description</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(description) ? "-" : description)</div>
                            </div>
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <div class="text-muted small">Group Name</div>
                                    <div class="fw-semibold">@Model.Name</div>
                                </div>
                                <div class="col-6 mb-3">
                                    <div class="text-muted small">Team Leader</div>
                                    <div class="fw-semibold">@((Model.TeamLeader != null) ? Model.TeamLeader.Email : "Unassigned")</div>
                                </div>
                                <div class="col-6 mb-3">
                                    <div class="text-muted small">Members</div>
                                    <div class="fw-semibold">@members.Count</div>
                                </div>
                                <div class="col-6 mb-3">
                                    <div class="text-muted small">Group Tasks</div>
                                    <div class="fw-semibold">@groupTasks.Count</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light fw-semibold">Settings</div>
                        <div class="card-body d-grid gap-2">
                            @if (canManage)
                            {
                                @Html.ActionLink("Edit Group", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-secondary" })
                                @Html.ActionLink("Delete Group", "Delete", new { id = Model.Id }, new { @class = "btn btn-outline-danger" })
                            }
                            else
                            {
                                <div class="text-muted">Only the team leader or admin can manage group settings.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="groupQuickAddTaskModal" tabindex="-1" aria-labelledby="groupQuickAddTaskLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="groupQuickAddTaskLabel">Add Group Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Partial("_GroupQuickAddTaskPartial")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="groupAddTaskBtn">Add Task</button>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "__AjaxAntiForgeryForm" }))
{@Html.AntiForgeryToken()}

@section scripts {
    <script>
        var groupId = @Model.Id;
        var token = $('input[name="__RequestVerificationToken"]', $('#__AjaxAntiForgeryForm')).val();

        $('#groupAddTaskBtn').on('click', function () {
            var t = $('#groupTaskTitle').val();
            var type = $('#groupTaskType').val();
            var priority = $('#groupTaskPriority').val();
            var dueDate = $('#groupTaskDueDate').val();
            if (!t) {
                return;
            }
            $.post('@Url.Action("AddGroupTask", "Groups")', {
                groupId: groupId,
                title: t,
                type: type,
                priority: priority,
                dueDate: dueDate,
                __RequestVerificationToken: token
            }, function (res) {
                if (res && res.success) {
                    location.reload();
                }
            });
        });

        (function () {
            var $kanban = $("#groupKanban");
            if (!$kanban.length) {
                return;
            }
            var dragTaskId = null;

            function statusStyle(status) {
                if (status === "InProgress") {
                    return "background: #fff3cd; color: #856404;";
                }
                if (status === "Done") {
                    return "background: #d1e7dd; color: #0f5132;";
                }
                return "background: #e8ecf1; color: #4b5661;";
            }

            $kanban.on("dragstart", ".kanban-card", function (event) {
                dragTaskId = $(this).data("task-id");
                event.originalEvent.dataTransfer.effectAllowed = "move";
                event.originalEvent.dataTransfer.setData("text/plain", dragTaskId);
            });

            $kanban.on("dragover", ".kanban-column", function (event) {
                event.preventDefault();
                event.originalEvent.dataTransfer.dropEffect = "move";
            });

            $kanban.on("drop", ".kanban-column", function (event) {
                event.preventDefault();
                var taskId = event.originalEvent.dataTransfer.getData("text/plain") || dragTaskId;
                var newStatus = $(this).data("status");
                if (!taskId || !newStatus) {
                    return;
                }
                var $card = $kanban.find('.kanban-card[data-task-id="' + taskId + '"]');
                if (!$card.length) {
                    return;
                }
                var currentStatus = $card.closest('.kanban-column').data("status");
                if (currentStatus === newStatus) {
                    return;
                }
                $.post('@Url.Action("UpdateGroupTaskStatus", "Groups")', {
                    taskId: taskId,
                    status: newStatus,
                    __RequestVerificationToken: token
                }, function (res) {
                    if (res && res.success) {
                        $card.find(".task-pill").first().attr("style", statusStyle(newStatus)).text(newStatus);
                        $(event.currentTarget).find(".kanban-list").append($card);
                    }
                });
            });

            $kanban.on("click", ".kanban-card .title", function () {
                var $card = $(this).closest(".kanban-card");
                var taskId = $card.data("task-id");
                var title = $card.data("task-title") || "";
                var type = $card.data("task-type") || "Homework";
                var priority = $card.data("task-priority") || "Medium";
                var dueDate = $card.data("task-duedate") || "";

                var dialogBody = '' +
                    '<div class="mb-2">' +
                    '<label class="form-label">Title</label>' +
                    '<input type="text" class="form-control form-control-sm" id="editGroupTaskTitle" />' +
                    '</div>' +
                    '<div class="row g-2 mb-2">' +
                    '<div class="col-6">' +
                    '<label class="form-label">Type</label>' +
                    '<select class="form-select form-select-sm" id="editGroupTaskType">' +
                    '<option>Lesson</option>' +
                    '<option>Auditory</option>' +
                    '<option>Homework</option>' +
                    '<option>Lab</option>' +
                    '<option>Project</option>' +
                    '<option>Exam</option>' +
                    '</select>' +
                    '</div>' +
                    '<div class="col-6">' +
                    '<label class="form-label">Priority</label>' +
                    '<select class="form-select form-select-sm" id="editGroupTaskPriority">' +
                    '<option>Low</option>' +
                    '<option>Medium</option>' +
                    '<option>High</option>' +
                    '</select>' +
                    '</div>' +
                    '</div>' +
                    '<div>' +
                    '<label class="form-label">Due Date</label>' +
                    '<input type="date" class="form-control form-control-sm" id="editGroupTaskDueDate" />' +
                    '</div>';

                var dialog = bootbox.dialog({
                    title: 'Edit Group Task',
                    message: dialogBody,
                    buttons: {
                        delete: {
                            label: 'Delete',
                            className: 'btn-danger',
                            callback: function () {
                                bootbox.confirm('Delete this task?', function (result) {
                                    if (!result) return;
                                    $.post('@Url.Action("DeleteGroupTask", "Groups")', {
                                        taskId: taskId,
                                        __RequestVerificationToken: token
                                    }, function (res) {
                                        if (res && res.success) {
                                            location.reload();
                                        } else {
                                            bootbox.alert('Error deleting task.');
                                        }
                                    });
                                });
                                return false;
                            }
                        },
                        cancel: { label: 'Cancel', className: 'btn-secondary' },
                        ok: {
                            label: 'Save',
                            className: 'btn-primary',
                            callback: function () {
                                var newTitle = $('#editGroupTaskTitle').val();
                                var newType = $('#editGroupTaskType').val();
                                var newPriority = $('#editGroupTaskPriority').val();
                                var newDueDate = $('#editGroupTaskDueDate').val();
                                if (!newTitle) {
                                    bootbox.alert('Title is required.');
                                    return false;
                                }
                                $.post('@Url.Action("UpdateGroupTask", "Groups")', {
                                    taskId: taskId,
                                    title: newTitle,
                                    type: newType,
                                    priority: newPriority,
                                    dueDate: newDueDate,
                                    __RequestVerificationToken: token
                                }, function (res) {
                                    if (res && res.success) {
                                        location.reload();
                                    } else {
                                        bootbox.alert('Error updating task.');
                                    }
                                });
                            }
                        }
                    }
                });

                dialog.on('shown.bs.modal', function () {
                    $('#editGroupTaskTitle').val(title);
                    $('#editGroupTaskType').val(type);
                    $('#editGroupTaskPriority').val(priority);
                    $('#editGroupTaskDueDate').val(dueDate);
                });
            });
        })();
    </script>
}

@section Styles {
    <style>
        .task-kanban {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .kanban-column {
            border: 1px solid var(--accent-color);
            background: #fff;
            border-radius: 14px;
            padding: 12px;
            min-height: 260px;
        }

            .kanban-column h5 {
                margin-bottom: 12px;
                font-weight: 600;
            }

        .kanban-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 200px;
        }

        .kanban-card {
            background: #fff;
            border: 1px solid #eef1f4;
            border-radius: 12px;
            padding: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
            cursor: grab;
        }

            .kanban-card:active {
                cursor: grabbing;
            }

        .kanban-meta {
            margin-top: 8px;
            color: #6c757d;
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
        }

        .task-pill {
            border-radius: 999px;
            padding: 0.2rem 0.55rem;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }
    </style>
}
