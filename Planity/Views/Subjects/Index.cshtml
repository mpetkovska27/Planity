@model IEnumerable<Planity.Models.Subject>
@{
    ViewBag.Title = "My Subjects";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="subject-hero d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-1" style="font-size: 1.6rem; color: var(--dark-color);">Subjects Hub</h1>
        <div style="color: #5b6468;">Organize, review, and manage subjects in one place.</div>
    </div>
    <div class="d-flex gap-2">
        @Html.ActionLink("Create Subject", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>

@section Breadcrumbs {
    <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Dashboard")">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Subjects</li>
        </ol>
    </nav>
}

<div class="row subjects-filters">
    <div class="col-md-6">
        <label>Search:</label>
        <input type="text" id="searchInput" class="form-control" placeholder="Search Subject Name..." />
    </div>
    <div class="col-md-6">
        <label>Sort By:</label>
        <select id="sortInput" class="form-control">
            <option value="default">Default (Year/Semester)</option>
            <option value="name">Name</option>
        </select>
    </div>
</div>

<table class="table table-hover subjects-table" id="subjectsTable">
    <thead>
        <tr>
            @if (isAdmin)
            {
                <th>Student</th>
            }
            <th>Subject</th>
            <th>Credits</th>
            <th>Progress</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="tableBody">
        @{
            var groupedSubjects = Model
                .GroupBy(s => new { s.Year, s.Semester })
                .OrderBy(g => g.Key.Year)
                .ThenBy(g => g.Key.Semester);
        }

        @foreach (var group in groupedSubjects)
        {
            var groupItems = group.ToList();
            

            <tr class="info group-header-template" style="font-weight:bold; display:none;">
                <td colspan="@(isAdmin ? 7 : 6)">
                    Year @group.Key.Year - Semester @group.Key.Semester
                </td>
            </tr>

            foreach (var item in groupItems)
            {
                var subjectTasks = item.Tasks.Where(t => t.SubjectId == item.Id).ToList();
                var totalTasks = subjectTasks.Count;
                var completedTasks = subjectTasks.Count(t => t.Status == Planity.Models.TaskStatus.Done);
                var progress = totalTasks > 0 ? (int)((double)completedTasks / totalTasks * 100) : 0;
               

                <tr class="subject-row"
                    data-year="@item.Year"
                    data-sem="@item.Semester"
                    data-name="@item.Name.ToLower()">

                    @if (isAdmin)
                    {
                        <td>@(item.User != null ? (item.User.UserName ?? item.User.Email) : "N/A")</td>
                    }
                    <td>
                        @Html.ActionLink(item.Name, "Details", new { id = item.Id }, new { style = "font-weight:bold; color: var(--dark-color);" })
                    </td>
                    <td>@item.Credits</td>
                    <td style="width: 20%;">
                        <div class="progress" style="margin-bottom: 0;">
                            <div class="progress-bar" role="progressbar"
                                 aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"
                                 style="width: @progress%; background-color: var(--primary-color);">
                                @progress%
                            </div>
                        </div>
                    </td>
                    
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-link" title="Edit" aria-label="Edit">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <button class="btn btn-link text-danger" type="button" title="Delete" aria-label="Delete"
                                onclick="deleteSubject(@item.Id, '@item.Name')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div id="paginationControls" style="text-align: center; margin-top: 20px;">
    <button class="btn btn-default" id="prevPage" disabled>Previous</button>
    <span id="pageInfo" style="margin: 0 15px; font-weight: bold;">Page 1</span>
    <button class="btn btn-default" id="nextPage">Next</button>
</div>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "__AjaxAntiForgeryForm" }))
{
    @Html.AntiForgeryToken()
}

@section scripts {
    <script>
        var allRows = [];
        var currentPage = 1;
        var pageSize = 20;
        var isAdmin = @(isAdmin.ToString().ToLower());
        var token = $('input[name="__RequestVerificationToken"]', $('#__AjaxAntiForgeryForm')).val();

        $(document).ready(function () {
            $('#tableBody .subject-row').each(function() {
                allRows.push($(this));
            });

            $('#searchInput').on('keyup', function() { renderTable(); });
            $('#sortInput').on('change', function() { renderTable(); });

            $('#prevPage').click(function() {
                if (currentPage > 1) {
                    currentPage--;
                    renderTable(false);
                }
            });

            $('#nextPage').click(function() {
                currentPage++;
                renderTable(false);
            });

            renderTable();
        });

        function renderTable(resetPage) {
            if (typeof resetPage === 'undefined') resetPage = true;
            if (resetPage) currentPage = 1;

            var searchText = $('#searchInput').val().toLowerCase();
            var sortBy = $('#sortInput').val();

            var filteredRows = [];
            for (var i = 0; i < allRows.length; i++) {
                var row = allRows[i];
                var name = row.data('name').toString();
               

                var matchesSearch = name.indexOf(searchText) > -1;

                if (matchesSearch) {
                    filteredRows.push(row);
                }
            }

            filteredRows.sort(function(a, b) {
                if (sortBy === 'default') {
                    var yA = parseInt(a.data('year'));
                    var yB = parseInt(b.data('year'));
                    if (yA !== yB) return yA - yB;
                    var sA = parseInt(a.data('sem'));
                    var sB = parseInt(b.data('sem'));
                    return sA - sB;
                } else if (sortBy === 'name') {
                    return a.data('name').localeCompare(b.data('name'));
                } 
            });

            var totalPages = Math.ceil(filteredRows.length / pageSize) || 1;
            if (currentPage > totalPages) currentPage = totalPages;

            $('#pageInfo').text("Page " + currentPage + " of " + totalPages);
            $('#prevPage').prop('disabled', currentPage === 1);
            $('#nextPage').prop('disabled', currentPage === totalPages);

            var start = (currentPage - 1) * pageSize;
            var pageRows = filteredRows.slice(start, start + pageSize);

            var tbody = $('#tableBody').empty();
            var lastGroup = "";
            var colspan = isAdmin ? 7 : 6;

            $.each(pageRows, function(index, row) {
                if (sortBy === 'default') {
                    var groupKey = row.data('year') + '-' + row.data('sem');
                    if (lastGroup !== groupKey) {
                        tbody.append(
                            '<tr class="info" style="font-weight:bold; background-color: var(--secondary-color);">' +
                            '<td colspan="' + colspan + '">Year ' + row.data('year') + ' - Semester ' + row.data('sem') +
                            '</td></tr>'
                        );
                        lastGroup = groupKey;
                    }
                }
                tbody.append(row);
            });

            if (filteredRows.length === 0) tbody.append('<tr><td colspan="' + colspan + '" class="text-center">No subjects found.</td></tr>');
        }

        function toggleStatus(id) {
            $.post('@Url.Action("ToggleStatus")', { id: id, __RequestVerificationToken: token }, function (res) {
                if (res.success) location.reload();
            });
        }

        function deleteSubject(id, name) {
            bootbox.confirm("Are you sure you want to delete subject: " + name + "?", function(result) {
                if (result) {
                    $.post('@Url.Action("Delete")', { id: id, __RequestVerificationToken: token }, function (res) {
                        if (res.success) location.reload();
                        else bootbox.alert("Error deleting subject.");
                    });
                }
            });
        }
    </script>
}

<style>
    body {
        background-color: #e0e9ef;
    }

    .subject-hero {
        background: #ffffff;
        border-radius: 16px;
        padding: 18px 20px;
    }

    .subjects-filters {
        margin-bottom: 20px;
        background-color: rgba(255, 255, 255, 0.92);
        padding: 15px;
        border-radius: 10px;
        border: 1px solid rgba(31, 42, 51, 0.12);
        box-shadow: 0 10px 24px rgba(31, 42, 51, 0.08);
    }

        .subjects-filters label {
            color: #2b3944;
            font-weight: 600;
            margin-bottom: 6px;
        }

    .subjects-table {
        background-color: rgba(255, 255, 255, 0.96);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(31, 42, 51, 0.08);
    }

        .subjects-table thead th {
            background-color: #23313b;
            color: #f3f6f9;
            border-bottom: none;
            padding-top: 12px;
            padding-bottom: 12px;
        }

        .subjects-table tbody tr {
            border-top: 1px solid rgba(31, 42, 51, 0.08);
        }

            .subjects-table tbody tr:hover {
                background-color: rgba(35, 49, 59, 0.06);
            }

        .subjects-table .progress {
            background-color: rgba(31, 42, 51, 0.12);
        }

        .subjects-table .label {
            color: #ffffff;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 8px;
        }

        .subjects-table .badge {
            color: #ffffff;
            font-weight: 600;
        }

        .subjects-table .group-header-template td {
            background-color: #dfe7ee;
            color: #1f2a33;
        }
</style>