@model IEnumerable<Planity.Models.TaskItem>
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Index";
    bool isAdmin = User.IsInRole("Admin");
    string currentUserId = User.Identity.GetUserId();
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
</p>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <tr>
            @if (isAdmin)
            {
                <th>
                    Student
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Group.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StudyPlan.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subject.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlanedHours)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                @if (isAdmin)
                {
                    <td>
                        @(item.User?.UserName ?? item.User?.Email ?? "N/A")
                    </td>
                }
                <td>
                    @if (item.IsGroupTask && item.Group != null)
                    {
                        @Html.DisplayFor(modelItem => item.Group.Name)
                    }
                    else
                    {
                        <text>-</text>
                    }
                </td>
                <td>
                    @(item.StudyPlan?.Name ?? "-")
                </td>
                <td>
                    @(item.Subject?.Name ?? "-")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Type)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Priority)
                </td>
                <td>
                    @if (item.Status == Planity.Models.TaskStatus.Done)
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else if (item.Status == Planity.Models.TaskStatus.InProgress)
                    {
                        <span class="badge bg-warning">@item.Status</span>
                    }
                    else if (item.Status == Planity.Models.TaskStatus.Overdue)
                    {
                        <span class="badge bg-danger">@item.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DueDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PlanedHours)
                </td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info" })
                    @if (isAdmin || item.UserId == currentUserId)
                    {
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                    }
                </td>
            </tr>
        }

    </table>
</div>
