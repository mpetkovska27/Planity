                    return;
                }

                var token = $form.find("input[name='__RequestVerificationToken']").val();
                var payload = {
                    __RequestVerificationToken: token,
                    id: $form.find("#taskDetailsId").val(),
                    title: $form.find("#taskDetailsTitle").val(),
                    description: $form.find("#taskDetailsDescription").val(),
                    dueDate: dueDate
                };

                $.ajax({
                    url: "@Url.Action("UpdateDetails", "TaskItems")",
                    method: "POST",
                    data: payload
                }).done(function () {
                    refreshRowFromModal($form);
                    var display = new Date(dueDate + "T00:00:00");
                    var month = display.toLocaleString("en-US", { month: "short" });
                    var formatted = String(display.getDate()).padStart(2, "0") + " " + month + " " + display.getFullYear();
                    $(".js-edit-due span").text(formatted).addClass("fw-bold");
                    applyFilters();
                }).fail(function () {
                    bootbox.alert("Could not update due date. Please try again.");
                });
            });

            $(document).on("change", ".js-detail-status", function () {
                var $toggle = $(this);
                var taskId = $toggle.data("task-id");
                var newStatus = this.checked ? "Done" : "ToDo";
                sendStatusUpdate(taskId, newStatus, function () {
                    var $row = $table.find('tr.task-row[data-task-id="' + taskId + '"]');
                    updateRowStatus($row, newStatus);
                    applySort();
                    applyFilters();
                });
            });

            $(document).on("click", ".js-toggle-priority", function () {
                var $btn = $(this);
                var taskId = $btn.data("task-id");
                var current = $btn.data("priority") || "Medium";
                var next = current === "High" ? "Medium" : "High";
                var token = $("#quickAddTaskForm input[name='__RequestVerificationToken']").val();
                $.ajax({
                    url: "@Url.Action("UpdatePriority", "TaskItems")",
                    method: "POST",
                    data: {
                        __RequestVerificationToken: token,
                        id: taskId,
                        priority: next
                    }
                }).done(function () {
                    $btn.data("priority", next);
                    $btn.find("i")
                        .removeClass("fa-solid fa-star text-warning fa-regular fa-star text-muted")
                        .addClass(next === "High" ? "fa-solid fa-star text-warning" : "fa-regular fa-star text-muted");

                    var $row = $table.find('tr.task-row[data-task-id="' + taskId + '"]');
                    $row.attr("data-priority", next);
                    $row.find("td").eq(@(isAdmin ? 5 : 4)).find("span").text(next);
                    applyFilters();
                }).fail(function () {
                    bootbox.alert("Could not update priority. Please try again.");
                });
            });

            $(document).on("click", ".js-add-subtask", function () {
                var $input = $("#taskSubtaskInput");
                var value = $.trim($input.val());
                if (!value) {
                    return;
                }

                var token = $("#taskDetailsForm input[name='__RequestVerificationToken']").val();
                var parentId = $("#taskDetailsId").val();
                $.ajax({
                    url: "@Url.Action("CreateSubtask", "TaskItems")",
                    method: "POST",
                    data: {
                        __RequestVerificationToken: token,
                        parentId: parentId,
                        title: value
                    }
                }).done(function (response) {
                    if (!response || !response.id) {
                        return;
                    }
                    var $item = $('<div class="list-group-item px-0 border-0 d-flex align-items-center gap-3"></div>');
                    $item.append('<input type="checkbox" class="form-check-input subtask-toggle m-0" style="width:20px; height:20px;" data-subtask-id="' + response.id + '" />');
                    $item.append('<span class="subtask-text">' + response.title + '</span>');
                    $item.append(
                        '<div class="ms-auto d-flex align-items-center gap-2">' +
                            '<button type="button" class="btn btn-sm btn-link text-primary p-0 js-edit-subtask" title="Edit subtask" data-subtask-id="' + response.id + '">' +
                                '<i class="fa-solid fa-pen-to-square"></i>' +
                            '</button>' +
                            '<button type="button" class="btn btn-sm btn-link text-danger p-0 js-delete-subtask" title="Delete subtask" data-subtask-id="' + response.id + '">' +
                                '<i class="fa-solid fa-trash"></i>' +
                            '</button>' +
                        '</div>'
                    );
                    $("#taskSubtasks").append($item);
                    $input.val("");
                }).fail(function () {
                    bootbox.alert("Could not add subtask. Please try again.");
                });
            });

            $(document).on("change", ".subtask-toggle", function () {
                var $toggle = $(this);
                var subtaskId = $toggle.data("subtask-id");
                var newStatus = this.checked ? "Done" : "ToDo";
                var token = $("#taskDetailsForm input[name='__RequestVerificationToken']").val();
                var $text = $toggle.closest(".list-group-item").find(".subtask-text");

                $.ajax({
                    url: "@Url.Action("UpdateStatus", "TaskItems")",
                    method: "POST",
                    data: {
                        __RequestVerificationToken: token,
                        id: subtaskId,
                        status: newStatus
                    }
                }).done(function () {
                    $text.toggleClass("text-decoration-line-through text-muted", newStatus === "Done");
                }).fail(function () {
                    bootbox.alert("Could not update subtask. Please try again.");
                    $toggle.prop("checked", !this.checked);
                });
            });

            $(document).on("click", ".js-edit-subtask", function () {
                var $button = $(this);
                var $item = $button.closest(".list-group-item");
                var subtaskId = $button.data("subtask-id");
                var $text = $item.find(".subtask-text");
                var currentTitle = $.trim($text.text());
                bootbox.prompt({
                    title: "Edit subtask",
                    value: currentTitle,
                    callback: function (result) {
                        if (result === null) {
                            return;
                        }
                        var title = $.trim(result);
                        if (!title) {
                            return;
                        }
                        var token = $("#taskDetailsForm input[name='__RequestVerificationToken']").val();
                        $.ajax({
                            url: "@Url.Action("UpdateDetails", "TaskItems")",
                            method: "POST",
                            data: {
                                __RequestVerificationToken: token,
                                id: subtaskId,
                                title: title,
                                description: null,
                                dueDate: null
                            }
                        }).done(function () {
                            $text.text(title);
                        }).fail(function () {
                            bootbox.alert("Could not update subtask. Please try again.");
                        });
                    }
                });
            });

            $(document).on("click", ".js-delete-subtask", function () {
                var $button = $(this);
                var $item = $button.closest(".list-group-item");
                var subtaskId = $button.data("subtask-id");
                var title = $.trim($item.find(".subtask-text").text());
                var token = $("#taskDetailsForm input[name='__RequestVerificationToken']").val();

                bootbox.confirm({
                    title: "Delete subtask",
                    message: "Are you sure you want to delete <strong>" + $("<div>").text(title).html() + "</strong>?",
                    buttons: {
                        confirm: { label: "Delete", className: "btn-danger" },
                        cancel: { label: "Cancel", className: "btn-secondary" }
                    },
                    callback: function (result) {
                        if (!result) {
                            return;
                        }
                        $.ajax({
                            url: "@Url.Action("Delete", "TaskItems")",
                            method: "POST",
                            data: {
                                __RequestVerificationToken: token,
                                id: subtaskId
                            }
                        }).done(function () {
                            $item.remove();
                        }).fail(function () {
                            bootbox.alert("Could not delete subtask. Please try again.");
                        });
                    }
                });
            });

            moveCompletedRows();
            applySort();
            refreshStats();
            renderKanban();
            updateCompletedHeaderVisibility();

            var savedView = localStorage.getItem("taskView");
            if (savedView) {
                $viewButtons.filter('[data-view="' + savedView + '"]').trigger("click");
            }
        })();
    </script>
}
