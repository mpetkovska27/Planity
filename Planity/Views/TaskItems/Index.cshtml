            function buildCard($row) {
                var title = $row.data("title") || "Untitled";
                var subject = $row.data("subject-name") || "-";
                var priority = ($row.data("priority") || "").toString();
                var status = ($row.data("status") || "").toString();
                var dueDisplay = $row.data("duedisplay") || "";
                var detailsUrl = $row.data("details-url");
                var editUrl = $row.data("edit-url");
                var deleteUrl = $row.data("delete-url");
                var canEdit = $row.data("can-edit") === true || $row.data("can-edit") === "True";

                var $card = $("<div>").addClass("kanban-card").attr("draggable", "true").attr("data-task-id", $row.data("task-id"));
                $("<div>").addClass("title").attr("style", "font-weight: 600; color: var(--dark-color);").text(title).appendTo($card);

                var $metaTop = $("<div>").addClass("d-flex align-items-center gap-2 mt-2");
                $("<span>").addClass("task-subject-badge").text(subject).appendTo($metaTop);
                var statusStyle = "background: #e8ecf1; color: #4b5661;";
                if (status === "InProgress") {
                    statusStyle = "background: #fff3cd; color: #856404;";
                } else if (status === "Done") {
                    statusStyle = "background: #d1e7dd; color: #0f5132;";
                } else if (status === "Overdue") {
                    statusStyle = "background: #f8d7da; color: #842029;";
                }
                $("<span>").addClass("task-pill").attr("style", statusStyle).text(status).appendTo($metaTop);
                $metaTop.appendTo($card);

                var $meta = $("<div>").addClass("kanban-meta");
                $("<span>").text(dueDisplay ? ("Due " + dueDisplay) : "No due date").appendTo($meta);
                $meta.appendTo($card);

                var $actions = $("<div>").addClass("kanban-actions mt-2 d-inline-flex gap-1 flex-wrap");
                if (canEdit) {
                    $("<a>")
                        .addClass("btn btn-sm btn-link text-primary")
                        .attr("href", editUrl)
                        .attr("title", "Edit task")
                        .html('<i class="fa-solid fa-pen-to-square"></i>')
                        .appendTo($actions);
                    $("<a>")
                        .addClass("btn btn-sm btn-link text-danger js-delete-task")
                        .attr("href", deleteUrl)
                        .attr("data-task-title", title)
                        .attr("title", "Delete task")
                        .html('<i class="fa-solid fa-trash"></i>')
                        .appendTo($actions);
                }
                $actions.appendTo($card);

                return $card;
            }

