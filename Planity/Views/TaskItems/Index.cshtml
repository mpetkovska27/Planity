            function applySort() {
                var sortValue = $sort.val();
                var $activeBody = $("#activeTasksBody");
                var $completedBody = $("#completedTasksBody");
                var rows = $activeBody.find("tr.task-row").get();
                var completedRows = $completedBody.find("tr.task-row").get();
                var priorityRank = { Low: 1, Medium: 2, High: 3 };

                function compareRows(a, b) {
                    var $a = $(a);
                    var $b = $(b);
                    var aDue = $a.data("due") || "";
                    var bDue = $b.data("due") || "";
                    var aTitle = normalizeText($a.data("title"));
                    var bTitle = normalizeText($b.data("title"));
                    var aPriority = $a.data("priority") || "";
                    var bPriority = $b.data("priority") || "";

                    if (sortValue === "due-desc") {
                        return bDue.localeCompare(aDue);
                    }
                    if (sortValue === "priority") {
                        return (priorityRank[bPriority] || 0) - (priorityRank[aPriority] || 0);
                    }
                    if (sortValue === "title") {
                        return aTitle.localeCompare(bTitle);
                    }
                    return aDue.localeCompare(bDue);
                }

                rows.sort(compareRows);
                completedRows.sort(compareRows);

                $.each(rows, function (_, row) {
                    $activeBody.append(row);
                });

                $.each(completedRows, function (_, row) {
                    $completedBody.append(row);
                });
            }

            function updateRowStatus($row, newStatus) {
                $row.attr("data-status", newStatus);
                $row.data("status", newStatus);
                $row.toggleClass("is-completed", newStatus === "Done");

                var $toggle = $row.find(".task-status-toggle");
                $toggle.attr("aria-pressed", newStatus === "Done" ? "true" : "false");
                $toggle.find("i")
                    .removeClass("fa-regular fa-circle fa-solid fa-circle-check")
                    .addClass(newStatus === "Done" ? "fa-solid fa-circle-check" : "fa-regular fa-circle");

                if (newStatus === "Done") {
                    $("#completedTasksBody").append($row);
                } else {
                    $("#activeTasksBody").append($row);
                }
            }

            function sendStatusUpdate(taskId, newStatus, onSuccess) {
                var token = $("#quickAddTaskForm input[name='__RequestVerificationToken']").val();
                $.ajax({
                    url: "@Url.Action("UpdateStatus", "TaskItems")",
                    method: "POST",
                    data: {
                        __RequestVerificationToken: token,
                        id: taskId,
                        status: newStatus
                    }
                }).done(function (response) {
                    if (response && response.repeatCreated) {
                        location.reload();
                        return;
                    }
                    if (onSuccess) {
                        onSuccess(response);
                    }
                }).fail(function () {
                    bootbox.alert("Could not update the task status. Please try again.");
                });
            }

            function refreshRowFromModal($form) {
                var taskId = $form.find("#taskDetailsId").val();
                var title = $form.find("#taskDetailsTitle").val();
                var dueDate = $form.find("#taskDetailsDueDate").val();
                var $row = $table.find('tr.task-row[data-task-id="' + taskId + '"]');
                if (!$row.length) {
                    return;
                }

                if (title) {
                    $row.attr("data-title", title);
                    $row.find(".task-title").text(title);
                    $kanban.find('.kanban-card[data-task-id="' + taskId + '"] .title').text(title);
                }

                if (dueDate) {
                    $row.attr("data-due", dueDate);
                    var display = new Date(dueDate + "T00:00:00");
                    var month = display.toLocaleString("en-US", { month: "short" });
                    var formatted = String(display.getDate()).padStart(2, "0") + " " + month + " " + display.getFullYear();
                    $row.find("td").eq(@(isAdmin ? 4 : 3)).text(formatted);
                }
