@model IEnumerable<Planity.Models.TaskItem>
@using System
@using System.Linq
@using Microsoft.AspNet.Identity
@using System.Web.Helpers

@{
    ViewBag.Title = "Tasks";
    bool isAdmin = User.IsInRole("Admin");
    string currentUserId = User.Identity.GetUserId();
    var allSubjects = (ViewBag.Subjects as IEnumerable<Planity.Models.Subject>) ?? Enumerable.Empty<Planity.Models.Subject>();
    var rootTasks = (Model ?? Enumerable.Empty<Planity.Models.TaskItem>())
        .Where(t => t.ParentTaskId == null)
        .ToList();
    var subjectGroups = allSubjects
        .GroupBy(s => new { s.Year, s.Semester })
        .OrderBy(g => g.Key.Year)
        .ThenBy(g => g.Key.Semester)
        .ToList();
}

@section Styles {
    <style>
        .task-sidebar,
        .task-hero,
        .task-stat,
        .task-utility,
        .task-advanced-filters,
        .task-table-wrapper,
        .kanban-column {
            border: 1px solid var(--accent-color);
        }

        .task-sidebar,
        .task-stat,
        .task-utility,
        .task-advanced-filters,
        .task-table-wrapper,
        .kanban-column {
            background: #fff;
        }

        .task-stat,
        .task-utility,
        .task-advanced-filters,
        .task-table-wrapper,
        .kanban-card {
            border-radius: 14px;
        }

        .task-sidebar {
            border-radius: 18px;
            padding: 16px;
            position: sticky;
            top: 20px;
        }

        .task-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 12px;
            color: #3d4a50;
            text-decoration: none;
        }

            .task-nav-item i {
                width: 18px;
                text-align: center;
                color: var(--primary-color);
            }

            .task-nav-item:hover,
            .task-nav-item.active {
                background: var(--secondary-color);
                color: var(--dark-color);
            }

        .task-projects-header {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #7b848b;
            margin-bottom: 8px;
        }

        .task-group-toggle {
            width: 100%;
            text-align: left;
            border: none;
            background: transparent;
            padding: 8px 12px;
            border-radius: 12px;
            font-weight: 600;
            color: #48525a;
        }

            .task-group-toggle i {
                margin-right: 8px;
                color: var(--primary-color);
            }

            .task-group-toggle:hover {
                background: var(--secondary-color);
            }

        .task-subject-item {
            padding-left: 36px;
            font-size: 0.95rem;
        }

        .task-hero {
            background: linear-gradient(135deg, var(--secondary-color), #f5f8fb);
            border-radius: 16px;
            padding: 18px 20px;
        }

        .task-stat {
            padding: 12px 14px;
        }

            .task-stat .label {
                color: #6c757d;
                font-size: 0.85rem;
            }

            .task-stat .value {
                font-size: 1.25rem;
                color: var(--dark-color);
                font-weight: 600;
            }

        .task-utility {
            padding: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: space-between;
        }

        .task-advanced-filters {
            padding: 12px 14px;
            margin-top: 12px;
        }

        .task-table-wrapper {
            padding: 8px 12px;
        }

            .task-table-wrapper table.dataTable tbody tr {
                border-bottom: 1px solid #eef1f4;
            }

                .task-table-wrapper table.dataTable tbody tr:hover {
                    background-color: #f6fbff;
                }

        .task-pill {
            border-radius: 999px;
            padding: 0.25rem 0.55rem;
            font-weight: 600;
            font-size: 0.78rem;
        }

        .task-row.is-completed .task-title {
            text-decoration: line-through;
            color: #7a8086;
        }

        .task-status-toggle {
            background: transparent;
            border: none;
            padding: 0;
            color: var(--primary-color);
            font-size: 1.15rem;
            cursor: pointer;
        }

            .task-status-toggle:disabled {
                cursor: not-allowed;
                opacity: 0.6;
            }

        .task-row.is-completed .task-status-toggle {
            color: var(--neutral-color);
        }

        .task-subject-badge {
            background: var(--secondary-color);
            color: #39434a;
            border-radius: 999px;
            padding: 0.2rem 0.55rem;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }

        .task-details-drawer {
            position: fixed;
            top: 0;
            right: -450px;
            width: 450px;
            height: 100vh;
            background: #fff;
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            transition: 0.3s ease;
            z-index: 1050;
            padding: 20px;
            overflow-y: auto;
        }

            .task-details-drawer.open {
                right: 0;
            }

            .task-details-drawer .drawer-header {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 16px;
            }

                .task-details-drawer .drawer-header h4 {
                    margin: 0;
                    font-size: 1.2rem;
                    color: var(--dark-color);
                }

        .task-empty {
            border: 1px dashed var(--accent-color);
            background: #fff;
            border-radius: 16px;
            padding: 24px;
            text-align: center;
        }

        .task-kanban {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .kanban-column {
            border-radius: 16px;
            padding: 12px;
            min-height: 320px;
        }

            .kanban-column h5 {
                font-size: 0.95rem;
                color: #475058;
                margin-bottom: 12px;
            }

        .kanban-card {
            border: 1px solid #eef1f4;
            padding: 12px;
            background: #fafbfd;
            margin-bottom: 12px;
        }


        .kanban-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
            color: #6b747b;
            margin-top: 8px;
        }

        .dataTables_filter,
        .dataTables_length {
            display: none;
        }
    </style>
}

@section Breadcrumbs {
    <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Dashboard")">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Tasks</li>
        </ol>
    </nav>
}

<div class="task-index container-fluid">
    <div class="row g-3">
        <aside class="col-lg-3">
            <div class="task-sidebar">
                <a href="#" class="task-nav-item" data-quick="today"><i class="fa-solid fa-sun"></i> My Day</a>
                <a href="#" class="task-nav-item" data-quick="important"><i class="fa-solid fa-star"></i> Important</a>
                <a href="#" class="task-nav-item" data-quick="planned"><i class="fa-solid fa-calendar"></i> Planned</a>
                <a href="#" class="task-nav-item" data-quick="completed"><i class="fa-solid fa-check"></i> Completed</a>
                <div class="task-divider" style="border-top: 1px solid var(--accent-color); margin: 16px 0"></div>
                <div class="task-projects-header">Projects / Subjects</div>
                <a href="#" class="task-nav-item active" data-quick="all"><i class="fa-solid fa-layer-group"></i> All Tasks</a>
                <button class="task-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#subjectsMenu" aria-expanded="false">
                    <i class="fa-solid fa-folder-open"></i> Subjects
                </button>
                <div class="collapse task-group-list" id="subjectsMenu">
                    @foreach (var group in subjectGroups)
                    {
                        var groupId = $"subjectGroup-{group.Key.Year}-{group.Key.Semester}";
                        <button class="task-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#@groupId" aria-expanded="false">
                            <i class="fa-solid fa-chevron-right"></i> Year @group.Key.Year / Semester @group.Key.Semester
                        </button>
                        <div class="collapse task-group-list" id="@groupId">
                            @foreach (var subject in group.OrderBy(s => s.Name))
                            {
                                <a href="#" class="task-nav-item task-subject-item" data-subject-id="@subject.Id">
                                    <i class="fa-regular fa-bookmark"></i> @subject.Name
                                </a>
                            }
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <button class="btn btn-outline-primary w-100" id="quickAddTask" type="button">
                        <i class="fa-solid fa-plus"></i> Quick Add Task
                    </button>
                </div>
                <form id="quickAddTaskForm" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </aside>

        <main class="col-lg-9">
            <div class="task-hero d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="mb-1" style="font-size: 1.6rem; color: var(--dark-color);">Task Hub</h1>
                    <div style="color: #5b6468;">Track, filter, and manage your workload with clarity.</div>
                </div>
                <div class="d-flex gap-2">
                    @Html.ActionLink("Create Task", "Create", null, new { @class = "btn btn-primary" })
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="task-stat">
                        <div class="label">Total Tasks</div>
                        <div class="value" id="stat-total">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="task-stat">
                        <div class="label">Due Soon (7 days)</div>
                        <div class="value" id="stat-due-soon">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="task-stat">
                        <div class="label">Overdue</div>
                        <div class="value text-danger" id="stat-overdue">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="task-stat">
                        <div class="label">In Progress</div>
                        <div class="value text-warning" id="stat-progress">0</div>
                    </div>
                </div>
            </div>

            <div class="task-utility mb-3">
                <div class="btn-group task-view-toggle" role="group" aria-label="View toggle">
                    <button type="button" class="btn btn-outline-secondary rounded-pill active" data-view="table">Table View</button>
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-view="kanban">Kanban Board</button>
                </div>

                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="task-search" class="form-control" placeholder="Search tasks, subjects, plans..." />
                </div>

                <select id="task-sort" class="form-select w-auto">
                    <option value="due-asc">Sort: Due date (soonest)</option>
                    <option value="due-desc">Sort: Due date (latest)</option>
                    <option value="priority">Sort: Priority</option>
                    <option value="title">Sort: Title</option>
                </select>

                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded="false">
                    <i class="fa-solid fa-filter"></i> Filters
                </button>
                <button class="btn btn-outline-secondary" id="filter-reset">Reset</button>
            </div>

            <div class="collapse" id="advancedFilters">
                <div class="task-advanced-filters">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select id="filter-status" class="form-select">
                                <option value="">All</option>
                                <option value="ToDo">To Do</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Done">Done</option>
                                <option value="Overdue">Overdue</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Priority</label>
                            <select id="filter-priority" class="form-select">
                                <option value="">All</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Type</label>
                            <select id="filter-type" class="form-select">
                                <option value="">All</option>
                                @foreach (var type in Enum.GetNames(typeof(Planity.Models.TaskType)))
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Due</label>
                            <select id="filter-due" class="form-select">
                                <option value="">Any time</option>
                                <option value="today">Today</option>
                                <option value="week">Next 7 days</option>
                                <option value="future">Future</option>
                                <option value="overdue">Overdue</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Subject</label>
                            <select id="filter-subject" class="form-select">
                                <option value="">All</option>
                                @foreach (var group in subjectGroups)
                                {
                                    <optgroup label="Year @group.Key.Year / Semester @group.Key.Semester">
                                        @foreach (var subject in group.OrderBy(s => s.Name))
                                        {
                                            <option value="@subject.Id">@subject.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            @if (!rootTasks.Any())
            {
                <div class="task-empty">
                    <h5 class="mb-2">No tasks yet</h5>
                </div>
            }
            else
            {
                <div id="tableView" class="task-table-wrapper table-responsive">
                    <table class="table align-middle mb-0" id="taskTable">
                        <thead>
                            <tr>
                                <th></th>
                                @if (isAdmin)
                                {
                                    <th>Student</th>
                                }
                                <th data-col="title">Task</th>
                                <th data-col="subject">Subject</th>
                                <th data-col="due">Due Date</th>
                                <th data-col="priority">Priority</th>
                                <th data-col="actions"></th>
                            </tr>
                        </thead>
                        <tbody id="activeTasksBody">
                            @foreach (var item in rootTasks)
                            {
                                var subjectName = item.Subject?.Name ?? "-";
                                var subjectId = item.SubjectId?.ToString() ?? "";
                                var dueIso = string.Format("{0:yyyy-MM-dd}", item.DueDate);
                                var dueDisplay = string.Format("{0:dd MMM}", item.DueDate);
                                var detailsUrl = Url.Action("Details", "TaskItems", new { id = item.Id });
                                var editUrl = Url.Action("Edit", "TaskItems", new { id = item.Id });
                                var deleteUrl = Url.Action("Delete", "TaskItems", new { id = item.Id });
                                var canEdit = isAdmin || item.UserId == currentUserId;
                                var priorityClass = item.Priority == Planity.Models.Priority.High
                                    ? "high"
                                    : item.Priority == Planity.Models.Priority.Medium ? "medium" : "low";
                                var statusClass = item.Status == Planity.Models.TaskStatus.Done
                                    ? "done"
                                    : item.Status == Planity.Models.TaskStatus.InProgress ? "progress"
                                    : item.Status == Planity.Models.TaskStatus.Overdue ? "overdue" : "todo";
                                var isCompleted = item.Status == Planity.Models.TaskStatus.Done;
                                <tr class="task-row @(isCompleted ? "is-completed" : "")"
                                    data-task-id="@item.Id"
                                    data-status="@item.Status"
                                    data-priority="@item.Priority"
                                    data-type="@item.Type"
                                    data-due="@dueIso"
                                    data-duedisplay="@dueDisplay"
                                    data-subject-id="@subjectId"
                                    data-subject-name="@subjectName"
                                    data-title="@item.Title"
                                    data-details-partial-url="@Url.Action("DetailsPartial", "TaskItems", new { id = item.Id })"
                                    data-details-url="@detailsUrl"
                                    data-edit-url="@editUrl"
                                    data-delete-url="@deleteUrl"
                                    data-can-edit="@canEdit"
                                    data-userid="@item.UserId">
                                    <td>
                                        <button type="button"
                                                class="task-status-toggle"
                                                data-task-id="@item.Id"
                                                aria-label="Toggle task status"
                                                aria-pressed="@(isCompleted ? "true" : "false")"
                                                @(canEdit ? "" : "disabled")>
                                            <i class="@(isCompleted ? "fa-solid fa-circle-check" : "fa-regular fa-circle")"></i>
                                        </button>
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td>
                                            @(item.User?.UserName ?? item.User?.Email ?? "N/A")
                                        </td>
                                    }
                                    <td>
                                        <a class="fw-semibold text-decoration-none task-title js-task-details"
                                           href="@detailsUrl"
                                           data-task-id="@item.Id"
                                           data-details-partial-url="@Url.Action("DetailsPartial", "TaskItems", new { id = item.Id })"
                                           style="display: inline-block;">@item.Title</a>
                                        <div class="small text-muted">@item.Type</div>
                                    </td>
                                    <td>
                                        <span class="task-subject-badge">@subjectName</span>
                                    </td>
                                    <td>@string.Format("{0:dd MMM yyyy}", item.DueDate)</td>
                                    <td>
                                        @{
                                            var priorityStyle = item.Priority == Planity.Models.Priority.High
                                                ? "color: #b02a37; font-weight: 600;"
                                                : item.Priority == Planity.Models.Priority.Medium
                                                    ? "color: #8a6d1d; font-weight: 600;"
                                                    : "color: #0f5132; font-weight: 600;";
                                        }
                                        <span style="@priorityStyle">@item.Priority</span>
                                    </td>
                                    <td class="task-actions text-end">
                                        @if (canEdit)
                                        {
                                            <div class="d-inline-flex gap-1">
                                                <a href="@editUrl" class="btn btn-sm btn-link text-primary" title="Edit task">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <a href="@deleteUrl"
                                                   class="btn btn-sm btn-link text-danger js-delete-task"
                                                   data-task-title="@item.Title"
                                                   title="Delete task">
                                                    <i class="fa-solid fa-trash"></i>
                                                </a>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tbody id="completedTasksBody">
                            <tr class="completed-section d-none text-muted fw-semibold" style="background: #f6f8fb;">
                                <td colspan="@(isAdmin ? 7 : 6)">Completed Tasks</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div id="kanbanView" class="task-kanban d-none">
                    <div class="kanban-column" data-status="ToDo">
                        <h5>To Do</h5>
                        <div class="kanban-list"></div>
                    </div>
                    <div class="kanban-column" data-status="InProgress">
                        <h5>In Progress</h5>
                        <div class="kanban-list"></div>
                    </div>
                    <div class="kanban-column" data-status="Done">
                        <h5>Done</h5>
                        <div class="kanban-list"></div>
                    </div>
                </div>
            }
        </main>
    </div>
</div>

<div id="taskDetailsPanel" class="task-details-drawer">
    <div class="drawer-header">
        <button id="closeDetails" class="btn-close" type="button" aria-label="Close"></button>
        <h4 id="detailTitle">Task Details</h4>
    </div>
    <div class="drawer-body">
        <div id="detailContent" class="text-muted">Loading...</div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-secondary" id="closeDetailsFooter">Close</button>
            <button type="button" class="btn btn-primary js-save-task">Save changes</button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var $table = $("#taskTable");
            var $kanban = $("#kanbanView");
            if (!$table.length && !$kanban.length) {
                return;
            }

            var $search = $("#task-search");
            var $status = $("#filter-status");
            var $priority = $("#filter-priority");
            var $type = $("#filter-type");
            var $due = $("#filter-due");
            var $subject = $("#filter-subject");
            var $sort = $("#task-sort");
            var $viewButtons = $(".task-view-toggle .btn");
            var $quickNav = $(".task-nav-item");
            var $quickAddBtn = $("#quickAddTask");
            var taskTypes = @Html.Raw(Json.Encode(Enum.GetNames(typeof(Planity.Models.TaskType))));
            var priorities = @Html.Raw(Json.Encode(Enum.GetNames(typeof(Planity.Models.Priority))));
            var subjects = @Html.Raw(Json.Encode(allSubjects.Select(s => new { id = s.Id, name = s.Name, year = s.Year, semester = s.Semester })));

            function normalizeText(value) {
                return (value || "").toString().toLowerCase();
            }

            function buildSubjectOptions() {
                if (!subjects || !subjects.length) {
                    return '<option value="">No subjects</option>';
                }

                var sorted = subjects.slice().sort(function (a, b) {
                    if (a.year !== b.year) {
                        return a.year - b.year;
                    }
                    if (a.semester !== b.semester) {
                        return a.semester - b.semester;
                    }
                    return a.name.localeCompare(b.name);
                });

                var optionHtml = '<option value="">No subject</option>';
                var currentGroup = "";
                sorted.forEach(function (subject) {
                    var groupKey = "Year " + subject.year + " / Semester " + subject.semester;
                    if (groupKey !== currentGroup) {
                        if (currentGroup) {
                            optionHtml += "</optgroup>";
                        }
                        optionHtml += '<optgroup label="' + groupKey + '">';
                        currentGroup = groupKey;
                    }
                    optionHtml += '<option value="' + subject.id + '">' + subject.name + '</option>';
                });

                if (currentGroup) {
                    optionHtml += "</optgroup>";
                }

                return optionHtml;
            }

            function rowMatchesFilters($row) {
                if (!$row.hasClass("task-row")) {
                    return false;
                }
                var status = ($row.data("status") || "").toString();
                var priority = ($row.data("priority") || "").toString();
                var type = ($row.data("type") || "").toString();
                var due = ($row.data("due") || "").toString();
                var subjectId = ($row.data("subject-id") || "").toString();

                if ($status.val() && $status.val() !== status) {
                    return false;
                }

                if ($priority.val() && $priority.val() !== priority) {
                    return false;
                }

                if ($type.val() && $type.val() !== type) {
                    return false;
                }

                if ($subject.val() && $subject.val() !== subjectId) {
                    return false;
                }

                if ($due.val()) {
                    var today = new Date();
                    today.setHours(0, 0, 0, 0);
                    var dueDate = due ? new Date(due + "T00:00:00") : null;

                    if ($due.val() === "today") {
                        if (!dueDate || dueDate.getTime() !== today.getTime()) {
                            return false;
                        }
                    }

                    if ($due.val() === "week") {
                        var weekAhead = new Date(today);
                        weekAhead.setDate(weekAhead.getDate() + 7);
                        if (!dueDate || dueDate < today || dueDate > weekAhead) {
                            return false;
                        }
                    }

                    if ($due.val() === "future") {
                        if (!dueDate || dueDate <= today) {
                            return false;
                        }
                    }

                    if ($due.val() === "overdue") {
                        if (!dueDate || dueDate >= today) {
                            return false;
                        }
                    }
                }

                var term = normalizeText($search.val());
                if (term) {
                    var haystack = normalizeText([
                        $row.data("title"),
                        $row.data("subject-name"),
                        $row.data("type"),
                        $row.text()
                    ].join(" "));
                    if (haystack.indexOf(term) === -1) {
                        return false;
                    }
                }

                return true;
            }

            function refreshStats() {
                var total = 0;
                var dueSoon = 0;
                var overdue = 0;
                var inProgress = 0;

                var today = new Date();
                today.setHours(0, 0, 0, 0);
                var weekAhead = new Date(today);
                weekAhead.setDate(weekAhead.getDate() + 7);

                $table.find("tbody tr.task-row").each(function () {
                    var $row = $(this);
                    if (!rowMatchesFilters($row)) {
                        return;
                    }
                    total += 1;
                    var status = ($row.data("status") || "").toString();
                    var due = ($row.data("due") || "").toString();
                    var dueDate = due ? new Date(due + "T00:00:00") : null;

                    if (status === "InProgress") {
                        inProgress += 1;
                    }

                    if (dueDate && dueDate < today && status !== "Done") {
                        overdue += 1;
                    }

                    if (dueDate && dueDate >= today && dueDate <= weekAhead && status !== "Done") {
                        dueSoon += 1;
                    }
                });

                $("#stat-total").text(total);
                $("#stat-due-soon").text(dueSoon);
                $("#stat-overdue").text(overdue);
                $("#stat-progress").text(inProgress);
            }

            function updateCompletedHeaderVisibility() {
                var $header = $("#completedTasksBody .completed-section");
                var hasCompletedVisible = $("#completedTasksBody tr.task-row").filter(function () {
                    return !$(this).hasClass("d-none");
