            var dragTaskId = null;

            $table.on("dragstart", "tr.task-row", function (event) {
                dragTaskId = $(this).data("task-id");
                event.originalEvent.dataTransfer.effectAllowed = "move";
                event.originalEvent.dataTransfer.setData("text/plain", dragTaskId);
            });

            $table.on("dragover", "tr.task-row", function (event) {
                event.preventDefault();
                event.originalEvent.dataTransfer.dropEffect = "move";
            });

            $table.on("drop", "tr.task-row", function (event) {
                event.preventDefault();
                var $target = $(this);
                var $dragRow = $table.find('tr.task-row[data-task-id="' + dragTaskId + '"]');
                if (!$dragRow.length || $dragRow.is($target)) {
                    return;
                }
                if ($dragRow.parent()[0] !== $target.parent()[0]) {
                    return;
                }
                var mid = $target.offset().top + ($target.outerHeight() / 2);
                if (event.originalEvent.clientY > mid) {
                    $target.after($dragRow);
                } else {
                    $target.before($dragRow);
                }
            });

            $kanban.on("dragstart", ".kanban-card", function (event) {
                dragTaskId = $(this).data("task-id");
