@{
    ViewBag.Title = "Home Page";
}
@section Styles {
    <link href="~/Content/home.css" rel="stylesheet" />
}

<section class="hero-section">
    <div class="container-fluid">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6">
                <h1 class="hero-title">Plan Smarter. Study Better. Achieve More.</h1>
                <p class="hero-subtitle">Welcome to Planity — your personal study organizer designed to help students manage subjects, assignments, exams, and goals all in one place.</p>
                <p class="hero-description">Stay productive, track progress, and make learning stress-free.</p>
                @if (!Request.IsAuthenticated){
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg hero-btn">Get Started →</a>
                }
                @if (Request.IsAuthenticated){
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary btn-lg hero-btn">Go to Dashboard →</a>
                }
            </div>
            <div class="col-lg-6">
                <div class="hero-image">
                    
                    <div class="hero-placeholder">
                        <i class="fas fa-graduation-cap fa-5x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="features-section py-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">
                        <i class="fas fa-university fa-2x"></i>
                    </div>
                    <h3>Academic Portfolio</h3>
                    <p>Track your subjects across semesters and years. Record your grades and monitor your GPA automatically.</p>
                    <p class="feature-benefit">Complete overview of your academic success in one place.</p>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">
                        <i class="fas fa-tasks fa-2x"></i>
                    </div>
                    <h3>Smart Task Management</h3>
                    <p>Create tasks for specific subjects, set priorities, and track status from To-Do to Done.</p>
                    <p class="feature-benefit">Stay organized with filtering by subject and urgency.</p>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">
                        <i class="fas fa-users-cog fa-2x"></i>
                    </div>
                    <h3>Team Collaboration</h3>
                    <p>Work on group projects with specialized roles for Team Leaders and Members.</p>
                    <p class="feature-benefit">Sync group deadlines directly into your personal schedule.</p>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon">
                        <i class="fas fa-magic fa-2x"></i>
                    </div>
                    <h3>Study Generator</h3>
                    <p>Our algorithm takes your deadlines and priorities to create a custom weekly or monthly plan.</p>
                    <p class="feature-benefit">No more guessing what to study next. Follow the plan and succeed.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="why-choose-section py-5">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title">Why Choose Planity?</h2>
                <div class="benefits-list">
                    <div class="benefit-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Easy to use, modern, and intuitive interface.</span>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Designed by students, for students.</span>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Helps you balance your time and improve study habits.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section py-5">
<div class="container-fluid">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h2 class="cta-title">Start organizing your studies today and unlock your academic potential.</h2>
                @if (!Request.IsAuthenticated){
                <p class="cta-subtitle">Sign up now and take control of your learning journey.</p>
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg">Sign Up Now</a>
                }
            </div>
        </div>
    </div>
</section>
