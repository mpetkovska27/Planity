@model IEnumerable<Planity.Models.Grade>
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Index";
    bool isAdmin = User.IsInRole("Admin");
    string currentUserId = User.Identity.GetUserId();
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
</p>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <tr>
            @if (isAdmin)
            {
                <th>
                    Student
                </th>
            }
            <th>
                @Html.DisplayNameFor(model => model.Subject.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Value)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                @if (isAdmin)
                {
                    <td>
                        @(item.User?.UserName ?? item.User?.Email ?? "N/A")
                    </td>
                }
                <td>
                    @Html.DisplayFor(modelItem => item.Subject.Name)
                </td>
                <td>
                    <strong>@Html.DisplayFor(modelItem => item.Value)</strong>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Type)
                </td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info" })
                    @if (isAdmin || item.UserId == currentUserId)
                    {
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                    }
                </td>
            </tr>
        }

    </table>
</div>
